{
  "manifest_version": 3,
  "name": "YT Speedify",
  "version": "1.0",
  "description": "yt-speedify",

  "action": {},

  "background": {
    "service_worker": "background.js"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "permissions": ["sidePanel"],

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' https://unpkg.com; object-src 'self'"
  }
}
